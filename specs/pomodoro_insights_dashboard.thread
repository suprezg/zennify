syntax = behavior

Feature: "Pomodoro Insights Dashboard"

    Note: [[
    As a User
    I want to view my accumulated focus metrics, streaks, multipliers, and temporal distribution charts
    So that I can evaluate my daily deep-work volume, peak productivity windows, and financial earnings
    ]]

    Diagram: "Pomodoro Analytics Visualization Pipeline" [[
    graph TD
        A[Completed Focus Sessions] --> B[Analytics Calculation Engine]
        B --> C[Total Zen Time]
        B --> D[Average Daily Focus]
        B --> E[Current Focus Streak & Multiplier]
        B --> F[Total Focus Coins Earned]
        B --> G[24-Hour Focus Distribution]
        B --> H[Day of Week Comparison]
        B --> I[Session Length Categorization]
        B --> J[30-Day Focus Trend]
    ]]

    Background: "Focus Session History"
        Given "the user has historical data from completed Pomodoro focus sessions"
        And "the user navigates to the Pomodoro Insights Dashboard view"

    Rule: "Core summary metrics aggregate total time investment and current economic streaks"

        Scenario: "Displaying total zen time and daily averages"
            Then "the dashboard displays the \"Total Zen Time\" representing the absolute accumulated focus time across all history"
            And "the dashboard displays the \"Average Daily Focus\" showing the mean minutes spent focusing per active day"

        Scenario: "Displaying focus streaks and active multipliers"
            Then "the dashboard displays the user's current focus session streak"
            And "the dashboard displays the active coin multiplier applied to earnings"

    Rule: "Economy verification ensures focus credits are recorded properly"

        Scenario: "Confirming wallet credit deposits for completed focus sessions"
            Then "the dashboard displays the total coins earned specifically via Pomodoro work sessions"
            And "the balance reflects that each completed focus session successfully credited the wallet according to economic configurations"

    Rule: "Visual charts map out productivity trends and hourly distributions"

        Scenario: "Analyzing hourly focus distribution"
            Then "the dashboard displays a \"24-Hour Focus Distribution\" chart"
            And "the chart visualizes which specific hours of the day the user performs the most deep work"

        Scenario: "Comparing performance by day of the week"
            Then "the dashboard displays a \"Day of Week Comparison\" chart"
            And "the chart highlights total focus time differentials across different days of the week"

        Scenario: "Reviewing variations in session lengths"
            Then "the dashboard displays a \"Session Distribution\" chart"
            And "the chart categorizes all performed focus sessions by their specific durations"

        Scenario: "Tracking monthly consistency patterns"
            Then "the dashboard displays a \"Focus Trend\" chart covering the last 30 days"
            And "the chart monitors the daily volume of focus time to show historical trends over the past month"